# Supabase — copiar a .env.local y llenar con los valores del proyecto
# (Dashboard → Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# "Publishable key" (sb_publishable_…). Solo se usa para auth del admin.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# "Secret key" (o "service_role"). NUNCA exponerla en el cliente ni commitearla.
SUPABASE_SERVICE_ROLE_KEY=

# Notificaciones push (genera un par con: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tucorreo@ejemplo.com

# URL pública del sitio (para los links de WhatsApp)
NEXT_PUBLIC_SITE_URL=https://dreamteamcolombia.vercel.app
